# ───────────────────────────────────────────────────────────────
# QuickShipDeals — variables d'environnement
# Copier en .env (développement). Ne JAMAIS versionner .env.
# En production, saisir ces valeurs dans Vercel (web) et chez l'hébergeur du worker.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettre aucun secret.
# ───────────────────────────────────────────────────────────────

# Environnement : development | preview | production
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données PostgreSQL (obligatoire)
DATABASE_URL=postgresql://qsd:qsd@localhost:5432/qsd_dev
DIRECT_URL=postgresql://qsd:qsd@localhost:5432/qsd_dev

# Authentification Better Auth (obligatoire) — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Premier administrateur créé par le seed (facultatif)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Redis (files BullMQ + limitation de débit) — obligatoire pour le worker
REDIS_URL=redis://localhost:6379

# Stripe — laisser vide = paiement "non configuré" (le checkout est désactivé)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — laisser vide = e-mails journalisés avec le statut "non configuré"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="QuickShipDeals <commandes@votre-domaine.fr>"
EMAIL_REPLY_TO=

# Stockage Cloudflare R2 (API S3) — laisser vide = upload d'images désactivé (URL saisies à la main)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Fournisseurs (facultatif — chaque adaptateur reste "non configuré" sans clé)
BIGBUY_API_KEY=
BIGBUY_API_URL=https://api.bigbuy.eu
CJ_API_EMAIL=
CJ_API_KEY=

# Suivi de colis (facultatif)
TRACK17_API_KEY=
AFTERSHIP_API_KEY=

# Clé pour l'API REST /api/v1 (intégrations externes) — générer avec : openssl rand -hex 32
API_V1_TOKEN=

# Monitoring (facultatif)
SENTRY_DSN=
LOG_LEVEL=info
